{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/setu",
      // No config file: everything is environment (see example.env). This runs
      // an unprivileged port with its own state, so debugging never touches a
      // real installation.
      "env": {
        "SETU_PORT": "8080",
        "SETU_STATE_DIR": "${workspaceFolder}/tmp/state"
      }
    }
  ]
}