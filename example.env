# Setu — every setting, with its default.
#
# Setu does NOT read this file. It is documentation you can copy from: export
# what you want to change, and leave the rest alone. Everything is optional —
# `setu` with an empty environment runs on the values shown here.
#
#   cp example.env .env && edit it, then:   set -a; . ./.env; set +a; setu
#   or systemd:  EnvironmentFile=/etc/setu/setu.env
#   or docker:   docker run --env-file .env --network host -v setu-state:/var/lib/setu setu
#
# There is no config file: this and the state file below are the whole
# installation. Devices are added in the app (Settings → Devices), never here.


# --- Access -----------------------------------------------------------------

# The ADMINISTRATOR's bearer token, required on /api and /ws, and the one you
# type into the app. It lives here rather than in the state file on purpose:
# nothing you do in the app — and no damaged or restored state — can lock you
# out of your own installation.
#
# Everyone else is added in the app (Settings -> People) with just a name; Setu
# generates their token and shows it once, and gives them a role plus the exact
# devices they may use. Do not hand out this token to share a few lights.
#
# Setu warns on every start while this is the default. Change it.
SETU_TOKEN=CHANGE_ME


# --- Where Setu listens -----------------------------------------------------

# TCP port. Default 80 for plain HTTP, and 443 once TLS is configured below —
# set this only to override that. Binding below 1024 needs privilege: run as
# root, or grant CAP_NET_BIND_SERVICE.
# SETU_PORT=80

# Bind address — the IP of one network interface, e.g. 192.168.1.10.
# Empty (the default) means all interfaces. Use 127.0.0.1 for loopback only.
# SETU_INTERFACE=


# --- HTTPS (optional) -------------------------------------------------------

# Your own (or self-signed) PEM certificate and key. Set BOTH or neither.
# HTTPS is what makes browsers treat a LAN address as a secure context, which
# the PWA needs to install and run its service worker. There is no ACME here —
# bring your own cert (script/gen-setu-cert.sh) or use Tailscale for zero-config
# HTTPS. Setting these moves the default port to 443.
# SETU_TLS_CERT=/etc/setu/cert.pem
# SETU_TLS_KEY=/etc/setu/key.pem


# --- Behaviour --------------------------------------------------------------

# Active-use poll cadence (Go duration: 45s, 1m, 500ms). With no app activity or
# device changes, polling backs off on its own through 5m, 10m, 30m, 1h, 6h;
# opening the app resets it. 0 disables scheduled polling (manual refresh still
# works).
# SETU_POLL_INTERVAL=45s


# --- State ------------------------------------------------------------------

# Where Setu keeps setu.json — your devices, automations and people — plus
# Samsung pairing tokens. The default is the OS temp directory, which usually
# does NOT survive a reboot: point this at real storage on any install you care
# about. Setu warns at startup while it is unset, and refuses to start if it
# cannot actually write there.
# SETU_STATE_DIR=/var/lib/setu
